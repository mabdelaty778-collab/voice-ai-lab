# Run python scripts/setup_lab.py to generate a random local key.
LAB_API_KEY=
LAB_DB_PATH=.local/lab.sqlite3
LAB_FAIL_WRITES=false

# Optional paid voice mode. Nothing uses this key in simulation mode.
LAB_ENABLE_VOICE=false
OPENAI_API_KEY=
LAB_REALTIME_MODEL=gpt-realtime
LAB_VOICE=marin

# Optional local measurement receipts from real voice sessions; disabled when blank.
LAB_MEASUREMENTS_DIR=
